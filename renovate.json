{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>projectbluefin/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.container\\.in$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)Image=(?<depName>[^:@\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Third-party GitHub Actions updates wait three days after release, then Renovate automerges them. The hive also merges Renovate PRs once the required checks pass, because mergeraptor is a trusted bot.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "!projectbluefin/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github-actions-third-party-non-major",
      "pinDigests": true,
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "First-party projectbluefin/** actions merge right away and open at any time.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "projectbluefin/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "github-actions-first-party-non-major",
      "pinDigests": true,
      "schedule": [
        "at any time"
      ],
      "automerge": true
    },
    {
      "description": "Renovate never automerges GitHub Actions majors. The hive's trusted-bot merge policy is independent of this setting.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
